# Firebase Authentication settings (same project as the browser login).
# The Web API key is a public Firebase project identifier, not a Gemini secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional runtime aliases; if absent, server uses matching VITE_FIREBASE_* values.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=

# Optional AI key: server only. Do not prefix it with VITE_.
GEMINI_API_KEY=
